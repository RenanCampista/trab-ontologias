digraph EsportsOntologyInstance {

  rankdir=LR;
  fontname="Helvetica";

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica"
  ];

  /* ====== KINDS ====== */
  subgraph cluster_kinds {
    label="Kinds";
    style=dashed;

    person_renan [label="person_renan : Person", fillcolor="#ffcccc"];
    person_ana   [label="person_ana : Person", fillcolor="#ffcccc"];

    team_dragons [label="team_dragons : Team\nregion=BR", fillcolor="#ffcccc"];
    team_wolves  [label="team_wolves : Team\nregion=BR", fillcolor="#ffcccc"];

    game_lol [label="game_lol : Game\nname=League of Legends", fillcolor="#ffcccc"];
    platform_pc [label="platform_pc : Platform\nname=PC", fillcolor="#ffcccc"];

    season_2024 [label="season_2024 : Season\nyear=2024", fillcolor="#ffcccc"];
    tournament_cblol [label="tournament_cblol : Tournament\nprizePool=2M", fillcolor="#ffcccc"];

    match_001 [label="match_001 : Match\ntype=BO1", fillcolor="#ffcccc"];
    match_002 [label="match_002 : Match\ntype=BO1", fillcolor="#ffcccc"];
  }

  /* ====== ROLES / PHASES ====== */
  subgraph cluster_roles {
    label="Roles and Phases";
    style=dashed;

    player_renan [label="player_renan : Player\nnickname=Renan", fillcolor="#cce5ff"];
    player_ana   [label="player_ana : Player\nnickname=Ana", fillcolor="#cce5ff"];

    active_player_renan [label="active_player_renan : ActivePlayer", fillcolor="#cce5ff"];
  }

  /* ====== RELATORS ====== */
  subgraph cluster_relators {
    label="Relators";
    style=dashed;

    participation_01 [label="participation_01 : Participation\nscore=10\ntime=35min", fillcolor="#ccffcc"];
    participation_02 [label="participation_02 : Participation\nscore=7\ntime=32min", fillcolor="#ccffcc"];

    team_part_01 [label="team_part_01 : TeamParticipation\nresult=win", fillcolor="#ccffcc"];
    team_part_02 [label="team_part_02 : TeamParticipation\nresult=loss", fillcolor="#ccffcc"];

    contract_01 [label="contract_01 : Contract\nstart=2024-01-01", fillcolor="#ccffcc"];
    contract_02 [label="contract_02 : Contract\nstart=2024-01-01", fillcolor="#ccffcc"];

    ranking_dragons [label="ranking_dragons : RankingEntry\npos=1\npoints=100", fillcolor="#ccffcc"];
    ranking_wolves  [label="ranking_wolves : RankingEntry\npos=2\npoints=80", fillcolor="#ccffcc"];
  }

  /* ====== INSTANCE RELATIONSHIPS ====== */

  /* Roles */
  player_renan -> person_renan [label="instanceOf"];
  player_ana   -> person_ana   [label="instanceOf"];
  active_player_renan -> player_renan [label="phaseOf"];

  /* Game & Platform */
  game_lol -> platform_pc [label="availableOn"];
  match_001 -> game_lol [label="isOf"];
  match_002 -> game_lol [label="isOf"];

  /* Tournament & Season */
  tournament_cblol -> season_2024 [label="occursIn"];
  match_001 -> tournament_cblol [label="partOf"];
  match_002 -> tournament_cblol [label="partOf"];

  /* Participation */
  player_renan -> participation_01 [label="participates"];
  participation_01 -> match_001 [label="inMatch"];

  player_ana -> participation_02 [label="participates"];
  participation_02 -> match_002 [label="inMatch"];

  /* Team Participation */
  team_dragons -> team_part_01 [label="competes"];
  team_part_01 -> match_001 [label="inMatch"];

  team_wolves -> team_part_02 [label="competes"];
  team_part_02 -> match_001 [label="inMatch"];

  /* Contracts */
  player_renan -> contract_01 [label="hasContract"];
  contract_01 -> team_dragons [label="withTeam"];

  player_ana -> contract_02 [label="hasContract"];
  contract_02 -> team_wolves [label="withTeam"];

  /* Ranking */
  team_dragons -> ranking_dragons [label="rankedAs"];
  ranking_dragons -> season_2024 [label="inSeason"];

  team_wolves -> ranking_wolves [label="rankedAs"];
  ranking_wolves -> season_2024 [label="inSeason"];
}
